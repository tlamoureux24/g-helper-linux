# G-Helper Linux - udev rules for non-root access to ASUS hardware controls
# Install: sudo cp 90-ghelper.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules
# Version: VERSION_PLACEHOLDER
#
# These rules grant read/write access to ASUS hardware controls for members of
# the "ghelper" group. The installer creates the group and adds the installing
# user; multi-user systems can opt in additional trusted users with:
#   sudo usermod -aG ghelper <user>

# asus-nb-wmi platform device: performance modes, power limits, panel overdrive.
SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{throttle_thermal_policy}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/throttle_thermal_policy"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{panel_od}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/panel_od"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{ppt_pl1_spl}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_pl1_spl"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{ppt_pl2_sppt}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_pl2_sppt"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{ppt_fppt}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_fppt"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{nv_dynamic_boost}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/nv_dynamic_boost"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{nv_temp_target}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/nv_temp_target"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{ppt_apu_sppt}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_apu_sppt"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{ppt_platform_sppt}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_platform_sppt"

# Fallback for attributes that appear after the platform event.
SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/ppt_pl1_spl /sys/devices/platform/asus-nb-wmi/ppt_pl2_sppt /sys/devices/platform/asus-nb-wmi/ppt_fppt /sys/devices/platform/asus-nb-wmi/ppt_apu_sppt /sys/devices/platform/asus-nb-wmi/ppt_platform_sppt /sys/devices/platform/asus-nb-wmi/nv_dynamic_boost /sys/devices/platform/asus-nb-wmi/nv_temp_target"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{egpu_enable}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/egpu_enable"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{egpu_connected}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/egpu_connected"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{boot_sound}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/platform/asus-nb-wmi/boot_sound"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/firmware/acpi/platform_profile /sys/devices/system/cpu/intel_pstate/no_turbo /sys/devices/system/cpu/cpufreq/boost"

# asus-nb-wmi bus device: GPU Eco mode, MUX switch, Mini LED.
SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{dgpu_disable}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/bus/platform/devices/asus-nb-wmi/dgpu_disable"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{gpu_mux_mode}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/bus/platform/devices/asus-nb-wmi/gpu_mux_mode"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  ATTR{mini_led_mode}!="", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/bus/platform/devices/asus-nb-wmi/mini_led_mode"

SUBSYSTEM=="platform", DRIVER=="asus-nb-wmi", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/bus/pci/rescan"

# Battery charge limit.
SUBSYSTEM=="power_supply", ATTR{type}=="Battery", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path $sys$devpath/charge_control_end_threshold"

# ASUS LEDs and keyboard backlight.
SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight*", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/class/leds/%k/brightness /sys/class/leds/%k/multi_intensity /sys/class/leds/%k/kbd_rgb_mode /sys/class/leds/%k/kbd_rgb_state"

SUBSYSTEM=="leds", KERNEL=="asus::lightbar", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/class/leds/asus::lightbar/brightness"

# Fan curves.
SUBSYSTEM=="hwmon", ATTR{name}=="asus_nb_wmi", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh glob /sys/class/hwmon/%k/pwm*_auto_point* /sys/class/hwmon/%k/pwm*_enable"

SUBSYSTEM=="hwmon", ATTR{name}=="asus_custom_fan_curve", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh glob /sys/class/hwmon/%k/pwm*_auto_point* /sys/class/hwmon/%k/pwm*_enable"

# CPU boost / platform profile.
ACTION=="add|change", SUBSYSTEM=="module", KERNEL=="intel_pstate", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/system/cpu/intel_pstate/no_turbo"

ACTION=="add|change", SUBSYSTEM=="module", KERNEL=="acpi_cpufreq", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/system/cpu/cpufreq/boost"

SUBSYSTEM=="cpu", ACTION=="add|change", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/devices/system/cpu/intel_pstate/no_turbo /sys/devices/system/cpu/cpufreq/boost /sys/firmware/acpi/platform_profile"

ACTION=="add|change", SUBSYSTEM=="acpi", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/firmware/acpi/platform_profile"

# ASUS input devices and HID raw devices.
SUBSYSTEM=="input", ATTRS{name}=="Asus WMI hotkeys", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /dev/input/%k"

SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="0b05", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /dev/input/%k"

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /dev/%k"

# I2C-HID ASUS keyboards have no USB parent; match via the HID uevent vendor id.
SUBSYSTEM=="hidraw", ACTION=="add", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh asus-hidraw %k"

# Backlight.
SUBSYSTEM=="backlight", ACTION=="add", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys%p/brightness"

# PCIe ASPM policy.
ACTION=="add|change", SUBSYSTEM=="module", KERNEL=="pcie_aspm", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/module/pcie_aspm/parameters/policy"

# ASUS firmware-attributes (asus-armoury, kernel 6.8+).
ACTION=="add|change", SUBSYSTEM=="firmware-attributes", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh glob /sys/class/firmware-attributes/asus-armoury/attributes/*/current_value"

ACTION=="add|change", SUBSYSTEM=="module", KERNEL=="asus_armoury", \
  RUN+="/bin/sh -c 'sleep 1; /usr/local/lib/ghelper/ghelper-permissions.sh glob /sys/class/firmware-attributes/asus-armoury/attributes/*/current_value'"

# ryzen_smu (Curve Optimizer undervolting).
ACTION=="add|change", SUBSYSTEM=="module", KERNEL=="ryzen_smu", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/kernel/ryzen_smu_drv/rsmu_cmd /sys/kernel/ryzen_smu_drv/smu_args"

SUBSYSTEM=="cpu", KERNEL=="cpu0", ACTION=="add|change", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh path /sys/kernel/ryzen_smu_drv/rsmu_cmd /sys/kernel/ryzen_smu_drv/smu_args"

# CPU online/offline (core toggling).
SUBSYSTEM=="cpu", ACTION=="add|change", \
  RUN+="/usr/local/lib/ghelper/ghelper-permissions.sh glob /sys/devices/system/cpu/cpu*/online"
